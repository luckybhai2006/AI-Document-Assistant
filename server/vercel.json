{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "functions": {
    "src/server.js": {
      "includeFiles": [
        "node_modules/@napi-rs/canvas/**",
        "node_modules/pdfjs-dist/**",
        "node_modules/pdf-parse/**"
      ]
    }
  }
}
